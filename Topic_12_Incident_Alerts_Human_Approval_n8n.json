        "jsCode": "const d=$getWorkflowStaticData('global');d.incidents=d.incidents||{};const i=$input.first().json;const now=Date.now();const prior=d.incidents[i.incident_id];const throttled=!!(prior&&now-Number(prior.lastAlertAt||0)<300000);if(!throttled)d.incidents[i.incident_id]={lastAlertAt:now,acknowledged:false,decision:null,severity:i.severity};return [{json:{...i,throttled,not_throttled:!throttled,throttle_window_seconds:300}}];"
      },
