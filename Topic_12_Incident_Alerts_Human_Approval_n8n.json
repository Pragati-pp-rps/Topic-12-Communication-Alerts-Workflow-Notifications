      "parameters": {
        "jsCode": "const input=$input.first().json||{};const b=input.body||input;const id=String(b.incident_id||b.incidentId||'').trim();const severity=String(b.severity||'INFO').trim().toUpperCase();if(!id)throw new Error('incident_id is required');return [{json:{incident_id:id,severity:severity==='CRITICAL'?'CRITICAL':'INFO',message:String(b.message||'Incident received'),timestamp:String(b.timestamp||new Date().toISOString()),sla_seconds:Math.max(1,Number(b.sla_seconds||30)),acknowledged:false,is_critical:severity==='CRITICAL'}}];"
      },
