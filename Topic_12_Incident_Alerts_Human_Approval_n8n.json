    {
      "parameters": {
        "jsCode": "const r=$input.first().json||{};const body=r.body||{};let p=body;if(typeof body.payload==='string'){try{p=JSON.parse(body.payload)}catch(e){p={}}}const a=(p.actions||[])[0]||{};const incident_id=String(a.value||body.incident_id||'').trim();const decision=a.action_id==='topic12_approve'?'Approved':a.action_id==='topic12_reject'?'Rejected':String(body.decision||'');const valid=!!incident_id&&['Approved','Rejected'].includes(decision);const d=$getWorkflowStaticData('global');d.incidents=d.incidents||{};const known=!!d.incidents[incident_id];if(valid&&known){d.incidents[incident_id].acknowledged=true;d.incidents[incident_id].decision=decision;d.incidents[incident_id].decidedAt=new Date().toISOString()}return [{json:{incident_id,decision,valid:valid&&known,acknowledged:valid&&known,approved:decision==='Approved',received_at:new Date().toISOString(),error:!known?'Unknown incident ID':!valid?'Invalid callback action or incident ID':null}}];"
      },
